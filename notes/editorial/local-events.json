    "after": "  /* 開催期限のある催し：既存のポスター面と朱・余白を継承 */\n  .local-events{max-width:1120px;margin:0 auto;padding:24px var(--gutter) 0;}\n  .local-events[hidden],.local-events [hidden]{display:none;}\n  .local-events-grid{display:grid;gap:8px;}\n  @media(min-width:760px){.local-events-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}\n  .local-event{padding:9px 12px 4px;border:1px solid var(--line);border-left:2px solid var(--vermilion);background:var(--card);}\n  .local-event .event-period{font-size:.82rem;color:var(--vermilion);margin:0;}\n  .local-event h3{font-size:clamp(16px,2.5vw,20px);margin:0;line-height:1.45;}\n  .local-event p{margin:0;}\n  .local-event .event-venue{color:var(--ink-soft);font-size:.82rem;line-height:1.5;}\n  @media(max-width:399px){.local-events{padding-top:16px;}.local-events-grid{gap:6px;grid-template-columns:minmax(0,1fr);}.local-event{min-width:0;padding:6px 10px 1px;overflow-wrap:anywhere;}.local-event .event-venue{display:none;}}\n  .local-event .event-links{display:flex;flex-wrap:wrap;gap:0 14px;margin:0;}\n  .local-event .event-links a{display:inline-flex;align-items:center;min-height:44px;text-underline-offset:.22em;font-size:.85rem;}\n  .local-event [data-event-day]:not([hidden]) ~ [data-event-day]:not([hidden])::before{content:\"・\";}\n  .local-events:not([hidden]) + .picks{padding-top:28px;}\n",
