    "after": "\n  /* 開催期限のある催し：既存のポスター面と朱・余白を継承 */\n  .local-events{max-width:1120px;margin:0 auto;padding:24px var(--gutter) 0;}\n  .local-events[hidden],.local-event[hidden]{display:none;}\n  .local-event{margin-top:8px;padding:14px clamp(14px,3vw,24px);border:1px solid var(--line);border-left:2px solid var(--vermilion);background:var(--card);}\n  .local-event .event-period{font-size:.82rem;color:var(--vermilion);margin:0 0 4px;}\n  .local-event h3{font-size:clamp(18px,3vw,23px);margin:0 0 4px;line-height:1.45;}\n  .local-event p{margin:0 0 6px;}\n  .local-event .event-venue{color:var(--ink-soft);font-size:.86rem;}\n  .local-event .event-links{display:flex;flex-wrap:wrap;gap:4px 18px;margin:4px 0 0;}\n  .local-event .event-links a{display:inline-flex;align-items:center;min-height:44px;text-underline-offset:.22em;}\n  .local-events:not([hidden]) + .picks{padding-top:28px;}\n</style>\n<noscript>",
